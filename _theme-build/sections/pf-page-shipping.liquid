<section class="section" style="padding-bottom:40px">
  <div class="wrap" style="text-align:center;max-width:800px;margin:0 auto">
    <span class="eyebrow">Shipping</span>
    <h1 style="font-size:clamp(2.5rem,5.5vw,4.3rem);font-weight:800;letter-spacing:-.035em;line-height:1.0;margin:16px 0 22px">Fast, tracked, and free over £25.</h1>
    <p style="font-size:1.18rem;color:var(--muted);line-height:1.6;max-width:620px;margin:0 auto">We dispatch from the UK within one working day, so your grip socks arrive before your next class.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
  <div class="sec-head"><div><span class="eyebrow">How we ship</span><h2 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;letter-spacing:-.03em;margin-top:10px">Everything you need to know.</h2></div></div>
  <div class="cardrow" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">
<div style="background:var(--cream-soft);border:1.5px solid var(--line);border-radius:20px;padding:32px"><h3 style="font-size:1.28rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px">UK delivery</h3><p style="color:var(--muted);line-height:1.55">Royal Mail Tracked, 2 to 4 working days. Free on orders over £25, otherwise a flat £2.99.</p></div>
<div style="background:var(--cream-soft);border:1.5px solid var(--line);border-radius:20px;padding:32px"><h3 style="font-size:1.28rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px">Same-day dispatch</h3><p style="color:var(--muted);line-height:1.55">Order before 2pm on a working day and it ships the same day, with tracking sent to your inbox.</p></div>
<div style="background:var(--cream-soft);border:1.5px solid var(--line);border-radius:20px;padding:32px"><h3 style="font-size:1.28rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px">Worldwide shipping</h3><p style="color:var(--muted);line-height:1.55">We ship internationally. Rates and delivery times are calculated at checkout.</p></div>
</div>
  </div>
</section>

<section class="section" style="padding-top:0;text-align:center">
  <div class="wrap">
    <p style="font-size:1.1rem;color:var(--muted);max-width:520px;margin:0 auto 22px">Still have a question about your order? We are happy to help.</p>
    <a class="btn" href="/pages/contact">Contact us</a>
  </div>
</section>
{% schema %}
{
  "name": "PF Page Shipping",
  "settings": [],
  "presets": [{ "name": "PF Page Shipping" }]
}
{% endschema %}
