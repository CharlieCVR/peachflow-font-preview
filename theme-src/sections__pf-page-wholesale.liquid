<section class="section" style="padding-bottom:40px">
  <div class="wrap" style="text-align:center;max-width:800px;margin:0 auto">
    <span class="eyebrow">Wholesale</span>
    <h1 style="font-size:clamp(2.5rem,5.5vw,4.3rem);font-weight:800;letter-spacing:-.035em;line-height:1.0;margin:16px 0 22px">Stock Peach &amp; Flow in your studio.</h1>
    <p style="font-size:1.18rem;color:var(--muted);line-height:1.6;max-width:620px;margin:0 auto">Loved by Pilates, barre and yoga studios across the UK: cute, durable grip socks your clients will actually want to take home, with healthy margins for you.</p>
    <a class="btn" href="#enquire" style="margin-top:30px">Become a stockist</a>
  </div>
</section>

<section class="section">
  <div class="wrap">
  <div class="sec-head"><div><span class="eyebrow">Why stock us</span><h2 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;letter-spacing:-.03em;margin-top:10px">Socks that sell themselves.</h2></div></div>
  <div class="cardrow" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">
<div style="background:var(--cream-soft);border:1.5px solid var(--line);border-radius:20px;padding:32px"><h3 style="font-size:1.28rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px">Healthy margins</h3><p style="color:var(--muted);line-height:1.55">Strong wholesale pricing with a low minimum order, so it&rsquo;s easy to start and easy to reorder.</p></div>
<div style="background:var(--cream-soft);border:1.5px solid var(--line);border-radius:20px;padding:32px"><h3 style="font-size:1.28rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px">Proven sellers</h3><p style="color:var(--muted);line-height:1.55">4.9/5 from 125+ reviews. The designs do the talking and the grip keeps them coming back.</p></div>
<div style="background:var(--cream-soft);border:1.5px solid var(--line);border-radius:20px;padding:32px"><h3 style="font-size:1.28rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px">Fast UK dispatch</h3><p style="color:var(--muted);line-height:1.55">Designed and shipped from the UK, with restocks turned around in days, not weeks.</p></div>
</div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
  <div class="sec-head"><div><span class="eyebrow">How it works</span><h2 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;letter-spacing:-.03em;margin-top:10px">Three steps to stocked.</h2></div></div>
  <div class="cardrow" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">
<div style="background:var(--cream-soft);border:1.5px solid var(--line);border-radius:20px;padding:32px"><div style="width:38px;height:38px;border-radius:50%;background:var(--terra);color:#fff;display:grid;place-items:center;font-weight:800;margin-bottom:16px">1</div><h3 style="font-size:1.28rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px">Apply</h3><p style="color:var(--muted);line-height:1.55">Fill in the short form below and tell us about your studio or store.</p></div>
<div style="background:var(--cream-soft);border:1.5px solid var(--line);border-radius:20px;padding:32px"><div style="width:38px;height:38px;border-radius:50%;background:var(--terra);color:#fff;display:grid;place-items:center;font-weight:800;margin-bottom:16px">2</div><h3 style="font-size:1.28rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px">Get your pack</h3><p style="color:var(--muted);line-height:1.55">We&rsquo;ll send wholesale pricing, minimums and a full line sheet.</p></div>
<div style="background:var(--cream-soft);border:1.5px solid var(--line);border-radius:20px;padding:32px"><div style="width:38px;height:38px;border-radius:50%;background:var(--terra);color:#fff;display:grid;place-items:center;font-weight:800;margin-bottom:16px">3</div><h3 style="font-size:1.28rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px">Order &amp; restock</h3><p style="color:var(--muted);line-height:1.55">Place your first order and top up anytime. Restocks ship fast.</p></div>
</div>
  </div>
</section>

<section class="section" id="enquire" style="padding-top:0">
  <div class="wrap" style="max-width:680px;margin:0 auto;background:var(--cream-soft);border:1.5px solid var(--line);border-radius:28px;padding:clamp(28px,5vw,56px)">
    <div style="text-align:center;margin-bottom:28px"><span class="eyebrow">Become a stockist</span>
    <h2 style="font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:800;letter-spacing:-.03em;margin-top:10px">Let&rsquo;s get you stocked.</h2>
    <p style="color:var(--muted);margin-top:10px">Tell us about your studio or store and we&rsquo;ll send pricing, minimums and a line sheet within one working day.</p></div>
    {% form 'contact' %}{% if form.posted_successfully? %}<p class='form-success'>Thanks! Your wholesale enquiry is in, we'll be in touch within 2 working days.</p>{% endif %}<div style="display:grid;gap:14px">
      <label><span class="flabel">Your name</span><input name="contact[name]" required type="text" placeholder="Alex Smith" style="width:100%;border:1.5px solid var(--line);border-radius:100px;padding:15px 22px;font-size:1rem;font-family:inherit;background:#fff" /></label>
      <label><span class="flabel">Email address</span><input name="contact[email]" required type="email" placeholder="you@studio.com" style="width:100%;border:1.5px solid var(--line);border-radius:100px;padding:15px 22px;font-size:1rem;font-family:inherit;background:#fff" /></label>
      <label><span class="flabel">Studio / store name</span><input name="contact[Studio or store]" type="text" placeholder="Flow Studio London" style="width:100%;border:1.5px solid var(--line);border-radius:100px;padding:15px 22px;font-size:1rem;font-family:inherit;background:#fff" /></label>
      <label><span class="flabel">Website or Instagram</span><input name="contact[Website or Instagram]" type="text" placeholder="@flowstudiolondon" style="width:100%;border:1.5px solid var(--line);border-radius:100px;padding:15px 22px;font-size:1rem;font-family:inherit;background:#fff" /></label>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <label><span class="flabel">Business type</span><select name="contact[Business type]" class="fsel"><option>Pilates studio</option><option>Yoga studio</option><option>Barre studio</option><option>Boutique / retail</option><option>Gym</option><option>Other</option></select></label>
        <label><span class="flabel">Monthly volume</span><select name="contact[Monthly volume]" class="fsel"><option>10 to 25 pairs</option><option>25 to 50 pairs</option><option>50 to 100 pairs</option><option>100+ pairs</option></select></label>
      </div>
      <label><span class="flabel">About you</span><textarea name="contact[body]" required placeholder="Tell us a little about your space and your clients" rows="3" style="width:100%;border:1.5px solid var(--line);border-radius:22px;padding:15px 22px;font-size:1rem;font-family:inherit;background:#fff;resize:vertical"></textarea></label>
      <button class="btn" type="submit" style="justify-self:start">Send enquiry</button>
    </div>{% endform %}
  </div>
</section>
{% schema %}
{
  "name": "PF Page Wholesale",
  "settings": [],
  "presets": [{ "name": "PF Page Wholesale" }]
}
{% endschema %}
