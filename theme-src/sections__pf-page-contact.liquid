<section class="section" style="padding-bottom:40px">
  <div class="wrap" style="text-align:center;max-width:800px;margin:0 auto">
    <span class="eyebrow">Contact</span>
    <h1 style="font-size:clamp(2.5rem,5.5vw,4.3rem);font-weight:800;letter-spacing:-.035em;line-height:1.0;margin:16px 0 22px">We are here to help.</h1>
    <p style="font-size:1.18rem;color:var(--muted);line-height:1.6;max-width:620px;margin:0 auto">Questions about an order, sizing, or stocking us? Drop us a line and we will reply within one working day.</p>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap" style="max-width:680px;margin:0 auto;background:var(--cream-soft);border:1.5px solid var(--line);border-radius:28px;padding:clamp(28px,5vw,56px)">
    <div style="text-align:center;margin-bottom:28px"><span class="eyebrow">Send a message</span>
    <h2 style="font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:800;letter-spacing:-.03em;margin-top:10px">Drop us a line.</h2>
    <p style="color:var(--muted);margin-top:10px">Or email us any time at <a href="mailto:hello@peachandflow.com" style="color:var(--terra-deep);font-weight:600">hello@peachandflow.com</a>.</p></div>
    {% form 'contact' %}{% if form.posted_successfully? %}<p class='form-success'>Thanks! Your message has been sent, we'll get back to you soon.</p>{% endif %}<div style="display:grid;gap:14px">
      <label><span class="flabel">Your name</span><input name="contact[name]" required type="text" placeholder="Alex Smith" style="width:100%;border:1.5px solid var(--line);border-radius:100px;padding:15px 22px;font-size:1rem;font-family:inherit;background:#fff" /></label>
      <label><span class="flabel">Email address</span><input name="contact[email]" required type="email" placeholder="you@email.com" style="width:100%;border:1.5px solid var(--line);border-radius:100px;padding:15px 22px;font-size:1rem;font-family:inherit;background:#fff" /></label>
      <label><span class="flabel">How can we help?</span><textarea name="contact[body]" required placeholder="Tell us about your order or question" rows="4" style="width:100%;border:1.5px solid var(--line);border-radius:22px;padding:15px 22px;font-size:1rem;font-family:inherit;background:#fff;resize:vertical"></textarea></label>
      <button class="btn" type="submit" style="justify-self:start">Send message</button>
    </div>{% endform %}
  </div>
</section>
{% schema %}
{
  "name": "PF Page Contact",
  "settings": [],
  "presets": [{ "name": "PF Page Contact" }]
}
{% endschema %}
