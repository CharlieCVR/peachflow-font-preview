<section class="section" style="padding-bottom:40px">
  <div class="wrap" style="text-align:center;max-width:800px;margin:0 auto">
    <span class="eyebrow">Size guide</span>
    <h1 style="font-size:clamp(2.5rem,5.5vw,4.3rem);font-weight:800;letter-spacing:-.035em;line-height:1.0;margin:16px 0 22px">One size, made to fit UK 3 to 6.</h1>
    <p style="font-size:1.18rem;color:var(--muted);line-height:1.6;max-width:620px;margin:0 auto">A ribbed, stretchy cuff and a cushioned sole are designed to hug a wide range of feet.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
  <div class="sec-head"><div><span class="eyebrow">The fit</span><h2 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;letter-spacing:-.03em;margin-top:10px">One size, three ways to read it.</h2></div></div>
  <div style="border:1.5px solid var(--line);border-radius:20px;overflow:hidden;background:var(--cream-soft)">
  <table class="sizetable">
    <tr><th>UK</th><th>EU</th><th>US</th><th>Foot length</th></tr>
    <tr><td>3 to 6</td><td>36 to 39</td><td>5 to 8</td><td>22 to 25.5 cm</td></tr>
  </table>
</div>
<p style="color:var(--muted);margin-top:18px;max-width:560px">Between sizes, or around a UK 7? The ribbed, arch-hugging cuff stretches to fit comfortably, most customers size in without thinking about it.</p>
</section>

<section class="section" style="padding-top:0;text-align:center">
  <div class="wrap"><h2 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;letter-spacing:-.03em;margin-bottom:24px">Found your fit?</h2>
  <a class="btn" href="{{ routes.all_products_collection_url }}">Shop the collection</a></div>
</section>
{% schema %}
{
  "name": "PF Page Size Guide",
  "settings": [],
  "presets": [{ "name": "PF Page Size Guide" }]
}
{% endschema %}
