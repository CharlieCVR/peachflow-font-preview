<!-- US VS THEM -->
<section class="vs">
  <div class="wrap">
    <div class="vs-head">
      <h2>Designed for Pilates. <span class="thin">Trusted for everyday studio use.</span></h2>
    </div>
    <div class="vs-panel">
      <div class="vs-table">
        <div class="vs-band"></div>
        <div class="vs-row vs-header">
          <div class="vs-feat">Feature</div>
          <div class="vs-us"><svg class="vs-logo logo-mark" aria-label="Peach & Flow"><use href="#pf-logo"/></svg></div>
          <div class="vs-them">Typical Grip Socks</div>
        </div>
        <div class="vs-row"><div class="vs-feat">Full-Coverage Hex Grip</div><div class="vs-us"><span class="vs-check">✓</span></div><div class="vs-them"><span class="vs-x">✕</span><span>Partial grip coverage</span></div></div>
        <div class="vs-row"><div class="vs-feat">Won't Yellow or Discolour</div><div class="vs-us"><span class="vs-check">✓</span></div><div class="vs-them"><span class="vs-x">✕</span><span>May discolour over time</span></div></div>
        <div class="vs-row"><div class="vs-feat">85% Cotton Cushion Sole</div><div class="vs-us"><span class="vs-check">✓</span></div><div class="vs-them"><span class="vs-x">✕</span><span>Lower cotton content</span></div></div>
        <div class="vs-row"><div class="vs-feat">Anti-Roll Cuff</div><div class="vs-us"><span class="vs-check">✓</span></div><div class="vs-them"><span class="vs-x">✕</span><span>Can roll or bunch</span></div></div>
        <div class="vs-row"><div class="vs-feat">Multiple Styles</div><div class="vs-us"><span class="vs-check">✓</span></div><div class="vs-them"><span class="vs-x">✕</span><span>Limited style options</span></div></div>
        <div class="vs-row"><div class="vs-feat">Holds Shape Wash After Wash</div><div class="vs-us"><span class="vs-check">✓</span></div><div class="vs-them"><span class="vs-x">✕</span><span>May stretch out over time</span></div></div>
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "PF Comparison Table",
  "settings": [],
  "presets": [{ "name": "PF Comparison Table" }]
}
{% endschema %}
